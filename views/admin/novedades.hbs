<div class="container" style="margin:100px auto">
  <div class="row">
    <div class="col">
      <p class="text-end"> Hola {{ usuario }}! <a href="/admin/login/logout" class="btn btn-sm btn-danger">Cerrar sesión
        <i class="fa fa-sign-out" aria-hidden="true"></i></a>
      </p>
    </div>
  </div>

  <div class="row" style="margin-top:-9px;">
    <div class="col-7">
      <h2>Listado de Novedades</h2>
    </div>
    <div class="col-5 text-end">
      <a href="" class="btn btn-success"><i class="fas fa-plus"></i> Nuevo</a>
    </div>
  </div>

  <div class="row">
    <div class="col">
      <table class="table">
        <thead class="table-dark">
          <tr>
            <th scope="col">#</th>
            <th scope="col">Titulo</th>
            <th scope="col" class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {{#each novedades}}
          <tr>
            <th scope="row">{{this.id}}</th>
            <td>{{this.titulo}}</td>
            <td class="text-end">
              <a href="" class="btn btn-secondary"><i class="fas fa-pencil-alt"></i></a>
              <a href="/admin/novedades/eliminar/{{this.id}}" class="btn btn-secondary"><i class="fas fa-trash"></i></a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

</div>